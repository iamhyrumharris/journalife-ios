<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Read by AppModel to find the shared container for the journal. -->
	<key>AppGroupIdentifier</key>
	<string>$(APP_GROUP_ID)</string>
	<!-- journal://entry/<uuid> and journal://new -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>journal</string>
			</array>
		</dict>
	</array>
	<!-- The .journalife backup file (a zip). Older exports used .journalarchive. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).archive</string>
			<key>UTTypeDescription</key>
			<string>Journal Archive</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>journalife</string>
					<string>journalarchive</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
